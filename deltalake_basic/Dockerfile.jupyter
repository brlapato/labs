# syntax=docker/dockerfile:1
# Base: official Spark 4.0.1 with Python 3 and Java 21
FROM spark:4.0.1-python3

USER root

# Install pip + JupyterLab
RUN apt-get update && apt-get install -y --no-install-recommends \
      python3-pip \
    && rm -rf /var/lib/apt/lists/*

RUN pip3 install --no-cache-dir \
      jupyterlab==4.* \
      delta-spark==4.0.0 \
      pyspark==4.0.1 \
      boto3 \
      pandas \
      pyarrow \
      matplotlib

# Create a jovyan user to match JupyterLab conventions
RUN useradd -m -s /bin/bash -u 1000 jovyan && \
    mkdir -p /home/jovyan/work && \
    chown -R jovyan:jovyan /home/jovyan && \
    # Give jovyan access to the Spark ivy cache volume mountpoint
    mkdir -p /opt/spark/.ivy2 && chown -R jovyan:jovyan /opt/spark/.ivy2

USER jovyan
WORKDIR /home/jovyan

EXPOSE 8888

CMD ["python3", "-m", "jupyter", "lab", \
     "--ip=0.0.0.0", \
     "--port=8888", \
     "--no-browser", \
     "--notebook-dir=/home/jovyan/work"]
